# Absolute origin, no trailing slash. Everything a crawler reads as a URL —
# the canonical tag, og:image, sitemap.xml, robots.txt — is built from this.
#
# Set it in Vercel for Production only. Preview deploys should leave it unset
# so they fall through to the production default rather than emitting
# canonicals that point at a preview hostname.
NEXT_PUBLIC_SITE_URL=https://blesc.jp

# Search Console → 設定 → 所有権の確認 → HTML タグ. Paste the content value
# only, not the whole <meta> tag. Optional: verification by DNS record or by
# the Google Analytics property works too, and needs nothing here.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
